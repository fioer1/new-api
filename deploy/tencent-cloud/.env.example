# Copy this file to .env on the Tencent Cloud server and replace every CHANGE_ME value.

# Use ":80" for first IP-only testing.
# Use your real domain, such as "api.example.com", after DNS points to the Tencent Cloud public IP.
DOMAIN=:80
ACME_EMAIL=admin@example.com

# Existing GitHub Actions publishes this image from the home-page branch.
NEW_API_IMAGE=ghcr.io/fioer1/new-api:home-page

TZ=Asia/Shanghai
NODE_NAME=tencent-cloud-1

POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=newapi

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET

ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
SYNC_FREQUENCY=60
MEMORY_CACHE_ENABLED=true
STREAMING_TIMEOUT=300
